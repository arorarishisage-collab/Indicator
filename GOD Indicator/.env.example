# Environment Variables Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# DATA SOURCE
# ============================================================================

# Yahoo Finance (yfinance) - No setup needed
DATA_SOURCE=yfinance
GOLD_SYMBOL=GC=F

# OANDA Forex API (optional, for more data sources)
# OANDA_API_KEY=your_oanda_key_here
# OANDA_ACCOUNT_ID=your_account_id_here

# ============================================================================
# TELEGRAM BOT
# ============================================================================

# Get these from BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================================================
# WEBHOOK SERVER
# ============================================================================

# Webhook security
WEBHOOK_KEY=your_secret_webhook_key_here
WEBHOOK_PORT=8000
WEBHOOK_HOST=0.0.0.0

# For production deployment (Heroku/Replit)
HEROKU_APP_URL=https://your-app-name.herokuapp.com

# ============================================================================
# BACKTEST SETTINGS
# ============================================================================

INITIAL_CAPITAL=10000
POSITION_SIZE=0.95
SLIPPAGE_PIPS=1.0
SPREAD_PIPS=0.5

# ============================================================================
# STRATEGY PARAMETERS
# ============================================================================

# Zone detection
SWING_LOOKBACK=20
ATR_MULTIPLIER=1.5
MIN_RISK_REWARD=1.5

# Moving averages
EMA_FAST=30
EMA_SLOW=200

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log
