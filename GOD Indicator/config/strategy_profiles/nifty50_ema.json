{
  "name": "nifty50_ema",
  "data_source": {
    "type": "yfinance",
    "symbol": "^NSEI",
    "interval": "5m",
    "period": "1mo",
    "timezone": "Asia/Kolkata"
  },
  "strategy": {
    "class": "EMA30Strategy",
    "params": {
      "fast_period": 9,
      "slow_period": 30,
      "rsi_period": 14,
      "rsi_threshold": 50,
      "pullback_bars": 3,
      "min_volume_factor": 1.2
    }
  },
  "filters": {
    "session_hours": [
      "09:15-15:30"
    ],
    "require_volume_spike": true,
    "trend_confirmation_tf": "15m"
  },
  "live": {
    "poll_interval_seconds": 300,
    "min_poll_seconds": 180,
    "max_poll_seconds": 600,
    "max_exposure_percent": 5.0,
    "risk_per_trade_percent": 1.0,
    "cooldown_minutes": 45,
    "session_hours": [
      "09:15-15:30"
    ],
    "max_concurrent_trades": 2,
    "alert_channels": [
      "main"
    ],
    "confidence_threshold": 2.0
  }
}
